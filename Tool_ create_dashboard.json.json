      "id": "56e8f653-f402-48c2-ac79-123b3ee6f331",
      "name": "Start"
    },
    {
      "parameters": {
        "jsCode": "const DB_ID = 2;\n\nconst start = $('Start').first().json;\nconst dashId = $input.first().json.id;\n\nlet charts = start.charts;\nif (typeof charts === 'string') charts = JSON.parse(charts.replace(/```json|```/g, '').trim());\n\nconst allowed = ['scalar', 'bar', 'line', 'pie', 'row', 'table', 'area'];\nconst out = [];\nfor (const c of charts) {\n  const sql = String(c.sql || '').trim().replace(/;+\\s*$/, '');\n  if (!/^(select|with)\\b/i.test(sql) || sql.includes(';')) continue;\n  if (/\\b(insert|update|delete|drop|alter|create|grant|truncate|copy|call)\\b/i.test(sql)) continue;\n  out.push({ json: {\n    dashId, dbId: DB_ID, sql,\n    title: String(c.title || 'Chart'),\n    display: allowed.includes(c.display) ? c.display : 'table',\n  } });\n}\nif (!out.length) throw new Error('No valid charts were provided.');\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "06385a05-e71f-45eb-adde-ac249c540b1e",
      "name": "Split charts"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst dashId = $('Split charts').first().json.dashId;\nconst good = items.filter(c => c.id);\n\nconst dashcards = good.map((c, i) => ({\n  id: -(i + 1), card_id: c.id,\n  row: Math.floor(i / 2) * 6, col: (i % 2) * 12,\n  size_x: 12, size_y: 6,\n  parameter_mappings: [], visualization_settings: {},\n}));\n\nreturn [{ json: { dashId, body: { dashcards }, failed: items.length - good.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        0
      ],
      "id": "38296dfc-f03d-44c4-b540-b6284a5c0511",
      "name": "Layout"
    },
    {
      "parameters": {
        "jsCode": "const l = $('Layout').first().json;\nreturn [{ json: {\n  status: 'created',\n  url: `http://localhost:3000/dashboard/${l.dashId}`,\n  charts_added: l.body.dashcards.length,\n  charts_failed: l.failed,\n} }];"
      },
